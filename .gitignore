# ---- 本地缓存（可重建） ----
.paper-cache/

# ---- 本地 Agent 工作区（运行态） ----
# 版本化的 agent 设定在 .agents/；.joycode 只是本地工具目录
.joycode/

# ---- 论文原文与大型二进制：默认不入库 ----
# GitHub 单文件上限 100MB；本仓库 Papers/ 下 PDF 合计约 280MB
# 确需纳入某篇时：git add -f "Papers/xxx.pdf"
*.pdf
*.whl
*.zip
*.7z
*.tar.gz

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- 临时文件 ----
*.tmp
~$*
/Papers
